# 1. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 2. (Optional) Which Gemini model to use (default: gemini-3-flash-preview)
GEMINI_MODEL=gemini-3-flash-preview

# 3. Agent Wallet Private Key on Base Sepolia (0x...)
#    CRITICAL: Never hardcode private keys in repository files!
#    Provide a dedicated Base Sepolia testnet key here.
WALLET_PRIVATE_KEY=

# 4. (Optional) Base Sepolia RPC endpoint
BASE_SEPOLIA_RPC=https://sepolia.base.org

# 5. (Optional) Dedicated x402 payment receiver address
X402_RECIPIENT_ADDRESS=0x6A19273c50978FE8df661A05b5f212879F4Eb6Eb
